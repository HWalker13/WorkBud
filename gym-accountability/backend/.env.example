# ── Core ──────────────────────────────────────────────────────────────
# Use this when running the backend on your HOST machine (normal local dev):
DATABASE_URL=postgresql://gym_user:gym_password@localhost:5432/gym_accountability
# Use this if you ever run the backend inside Docker:
# DATABASE_URL=postgresql://gym_user:gym_password@postgres:5432/gym_accountability

# JWT
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days

# CORS
FRONTEND_URL=http://localhost:5173

# ── Phase 2: S3 Photo Upload ───────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=gymbuddy-photos
AWS_REGION=us-east-1

# ── Phase 2: AI Verification ──────────────────────────────────────────
OPENAI_API_KEY=

# ── Phase 6: Celery / Redis ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
